# Server port (optional, defaults to 3000)
PORT=3000

# ScrapingBee JS rendering fallback
# Get your API key at https://app.scrapingbee.com
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here
ENABLE_JS_FALLBACK=true

# Comma-separated list of partner domains (subdomain-aware matching)
PARTNER_DOMAINS=lucky7even.com,spinjo.com,rocketspin.com,luckyvibe.com,rollero.com,rooster.bet,fortuneplay.com,spinsup.com,playmojo.com,novadreams.com,roosterpartner.media,roosterspartners.media,mediaroosters.com,lucky7even.org,lucky7even21.com,roosterbet.live,fortuneplay.co,spinjo.live,spinsup.live,rocketspin.live,playmojo.live,novadreams.live,luckyvibe.live,rollero.live,rooster-partner.com,roosters-partner.com,roosterpartners.media,roosterspartners.com,rooster-partners.com

# Max redirect hops per attempt
MAX_HOPS=20

# Max retry attempts if partner domain not found
MAX_RETRIES=3

# Delay between retries in milliseconds
RETRY_DELAY_MS=1000

# Request timeout in milliseconds
TIMEOUT_MS=10000
